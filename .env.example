# Copy this file to .env and fill in your key. .env is git-ignored.
SARVAM_API_KEY=

# Everything below is optional.

# Where the web app listens. Keep it on loopback unless you know why you're changing it.
# VAK_HOST=127.0.0.1
# VAK_PORT=8420

# Folder for the SQLite file (usage ledger, cache, past audits) and generated audio.
# VAK_DATA_DIR=./data

# Models. These are the defaults.
# VAK_TARGET_MODEL=sarvam-105b-conversations
# VAK_PLAN_MODEL=sarvam-105b
# VAK_JUDGE_MODEL=sarvam-105b
# VAK_EXPLAIN_MODEL=sarvam-105b
# VAK_STT_MODEL=saaras:v4
# VAK_TTS_MODEL=bulbul:v4-flash
# VAK_TRANSLATE_MODEL=mayura:v1

# Requests per minute Vak allows itself per service. Sarvam's pay-as-you-go
# ceiling is 60, so these leave some headroom.
# VAK_RPM_LLM=48
# VAK_RPM_SPEECH=48
# VAK_RPM_TEXT=48

# Refuse to start an audit whose estimate is above this many rupees.
# VAK_AUDIT_COST_CAP_INR=15

# Allow auditing your own OpenAI-compatible endpoint from the UI (0 to turn off).
# VAK_ALLOW_CUSTOM_TARGETS=1

# Rupee pots for the budget meter (these are the numbers from the project brief).
# VAK_BUDGET_STT=5000
# VAK_BUDGET_TTS=4000
# VAK_BUDGET_LLM=10000
# VAK_BUDGET_TRANSLATE=3000
# VAK_BUDGET_BUFFER=3000
