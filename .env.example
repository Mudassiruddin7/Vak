# Required for the server's own key. Visitors can also bring theirs in Settings.
SARVAM_API_KEY=

# Optional: sign-in and saved audits (the publishable/anon key is meant to be public)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Optional knobs
# VAK_PORT=8420
# VAK_HOSTED=1              # public deployment: binds 0.0.0.0, trusts the proxy's client IP, blocks custom endpoints
# VAK_TARGET_MODEL=sarvam-105b-conversations
# VAK_JUDGE_MODEL=sarvam-105b
# VAK_ANON_UNITS_PER_DAY=24
# VAK_USER_UNITS_PER_DAY=80
# VAK_AUDIT_COST_CAP_INR=15
# VAK_SIGNING_KEY=          # any long random string; keeps report signatures valid across instances
